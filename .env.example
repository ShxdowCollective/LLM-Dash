# LLM-Dash local environment. Copy to .env (gitignored) and fill in.
# The `llm-dash` CLI loads this file automatically for local launches. Source it
# manually before dev-only commands like `npm ci`:
#   set -a; . ./.env; set +a
# Variable names match what scripts/config.py reads. Provider env vars are
# read-only overrides that take precedence over wizard/broker config.

# --- Local server -------------------------------------------------------------
LLM_DASH_HOST=127.0.0.1
LLM_DASH_PORT=8787
# LLM_DASH_LOG_PATH=
# LLM_DASH_NO_BROWSER=1

# --- Agent Provider (BYOK) ---------------------------------------------------
# The OpenAI-compatible endpoint + model the research agent uses for catalog
# seeding and daily updates.
LLM_DASH_API_KEY=
LLM_DASH_BASE_URL=
# Set to `root` when LLM_DASH_BASE_URL already ends in /v1; otherwise leave unset
# (defaults to append_v1, which appends /v1).
LLM_DASH_ENDPOINT_MODE=
LLM_DASH_DEFAULT_MODEL=
# LLM_DASH_BACKUP_MODEL=

# --- Research integrations (optional; gate the seed presets) -----------------
EXA_API_KEY=
ARTIFICIAL_ANALYSIS_API_KEY=
LLM_STATS_API_KEY=

# --- GitHub Packages ---------------------------------------------------------
# read:packages token for @shxdowcollective scoped npm deps. Source before:
#   set -a; . ./.env; set +a; npm ci
GH_PACKAGES_KEY=
